# Coverage configuration for osint-trust-envelope.
#
# Standalone .coveragerc because pyproject.toml currently carries no
# [tool.coverage.*] config. src-layout package, so the source root is "src"
# (measuring "src/osint_trust_envelope" mis-reports the package as never
# imported -> 0%).
#
# fail_under started conservative (80) for a first pass. Measured 2026-09-15:
# actual coverage is 94% (was 88% at the 0.2.0 release per CHANGELOG, drifted
# further since without the floor being ratcheted) -- ratcheted to 90, a
# margin below the measured number rather than pinned to it exactly.

[run]
source = src
branch = True

[report]
show_missing = True
skip_covered = False
fail_under = 90
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
